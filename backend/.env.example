# 运行环境：development 或 production。生产环境必须设置独立且不少于 32 字符的 SECRET_KEY。
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./smart_format.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DeepSeek 仅由后端读取；不要将真实密钥提交到 Git 仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地文件存储与上传保护。
STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=20971520
MAX_UNCOMPRESSED_BYTES=104857600
MAX_ZIP_ENTRIES=3000
WORKSPACE_QUOTA_BYTES=524288000

# 浏览器前端地址，使用 JSON 数组。生产环境请替换为实际站点地址。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 可选：扫描型 PDF 的本地 OCR 依赖。未配置时使用系统 PATH 中的同名命令。
PDFTOPPM_COMMAND=pdftoppm
TESSERACT_COMMAND=tesseract
TESSDATA_DIR=
